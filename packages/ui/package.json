{
	"name": "@meadow/ui",
	"version": "0.0.1",
	"license": "MIT",
	"scripts": {
		"dev": "svelte-kit sync && svelte-package --input src --output dist --watch",
		"build": "svelte-kit sync && svelte-package --input src --output dist",
		"test": "vitest test",
		"test:watch": "vitest test --watch",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch"
	},
	"type": "module",
	"files": ["dist"],
	"sideEffects": ["**/*.css"],
	"exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./navigation": {
            "types": "./componensts/navigation/index.d.ts",
            "svelte": "./components/navigation/index.js",
            "default": "./components/navigation/index.js"
        }
	},
	"peerDependencies": {
		"svelte": "^5.0.0",
		"tailwindcss": "^4.0.0"
	},
	"devDependencies": {
		"@lucide/svelte": "^0.563.1",
		"@sveltejs/adapter-auto": "^4.0.0",
		"@sveltejs/kit": "^2.43.1",
		"@sveltejs/package": "^2.0.0",
		"@sveltejs/vite-plugin-svelte": "^6.2.0",
		"@tailwindcss/vite": "^4.0.0",
		"jsdom": "^26.1.0",
		"publint": "^0.3.2",
		"svelte": "^5.39.4",
		"svelte-check": "^4.3.2",
		"tailwindcss": "^4.0.0",
		"typescript": "^5.9.2",
		"vite": "^7.1.7",
		"vitest": "^3.1.2"
	}
}
